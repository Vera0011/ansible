Screen {
    layout: grid;
    grid-size: 3 3;
    grid-columns: 24 1fr 1fr;
    grid-rows: auto 1fr 12;
}

#header {
    column-span: 3;
    height: 3;
    background: $panel;
    border-bottom: solid $primary;
    padding: 0 1;
}

#roles-panel {
    row-span: 2;
    background: $surface;
    border-right: solid $primary;
}

#main-area {
    column-span: 2;
}

#log-panel {
    column-span: 3;
    background: $surface-darken-1;
    border-top: solid $primary;
}

RolesPanel > ListView {
    height: 1fr;
}

.role-item {
    padding: 0 1;
}

#env-select {
    width: 30;
}

TabbedContent {
    height: 1fr;
}